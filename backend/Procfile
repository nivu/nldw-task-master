web: uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}
worker: celery -A app.worker worker --loglevel=info
# The nightly auto-approval sweep (spec Q-04) is a beat schedule, so a beat
# process must run alongside the worker. Without this, pending bookings whose
# date has passed stay pending forever — records that are neither absence nor
# attendance, which is exactly what §1 says the email workflow already produces.
beat: celery -A app.worker beat --loglevel=info
# Spec 007 Gmail sync (FR-CRM-SYNC-04): its own queue, one task at a time, so a
# backfill never takes the shared worker's slots. The only process given the
# Gmail key; run it once sync is switched on.
worker_crm_sync: celery -A app.worker worker -Q crm_sync --concurrency=1 --loglevel=info
# Spec 009 AI jobs (FR-CRMAI-JOB-04): their own queue, one task at a time. The
# only process given the Claude and Fireflies keys.
worker_crm_ai: celery -A app.worker worker -Q crm-ai --concurrency=1 --loglevel=info
