SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Optional. When set, access tokens are verified locally (HS256) instead of
# calling GoTrue on every request. Find it in Supabase → Settings → API.
SUPABASE_JWT_SECRET=

REDIS_URL=redis://localhost:6379/0
FRONTEND_URL=http://localhost:3000

# Run a Celery worker inside the API process instead of as a separate service.
# Leave unset/false in production — a dedicated worker service handles tasks.
RUN_EMBEDDED_WORKER=false

# Notifications (FR-NOTIF). Every sender is inert until its credentials are
# present: a missing credential is logged and skipped, and never fails a
# booking (FR-NOTIF-05). Slack is primary, email is the fallback.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
