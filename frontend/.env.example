NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side only — deliberately NOT NEXT_PUBLIC_. The browser reaches the
# backend only through /api/proxy, so this address must never enter a client
# bundle (constitution, Security-First).
BACKEND_URL=http://127.0.0.1:8000
