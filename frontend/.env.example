NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side only — deliberately NOT NEXT_PUBLIC_. The browser reaches the
# backend only through /api/proxy, so this address must never enter a client
# bundle (constitution, Security-First).
BACKEND_URL=http://127.0.0.1:8000

# Development only. Renders a password form on the sign-in page so the
# browser tests can sign in as the seeded accounts — Google OAuth cannot be
# driven headlessly. MUST NOT be set in production, where FR-AUTH-08 makes
# Google the only way in. Note this flag is not the control: Supabase's
# email provider is disabled server-side, so the form cannot work there
# regardless.
NEXT_PUBLIC_ENABLE_PASSWORD_LOGIN=false
