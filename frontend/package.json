  "packageManager": "pnpm@9.6.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.101.1",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "_comment_pnpm_overrides": [
    "next 16.2.11 pins postcss 8.4.31 and sharp 0.34.5, both of which carry",
    "published advisories: postcss GHSA-r28c-9q8g-f849 and GHSA-6g55-p6wh-862q",
    "(high, arbitrary file read via an attacker-controlled sourceMappingURL),",
    "GHSA-fxqj-rqcc-2cmp and GHSA-qx2v-qp2m-jg93 (moderate); sharp",
    "GHSA-f88m-g3jw-g9cj (high, inherited libvips CVEs).",
    "Both are build-time only here and neither processes untrusted input in",
    "this product, but leaving known-vulnerable versions pinned is not a",
    "position worth defending. Remove these overrides once next ships",
    "versions that already satisfy them."
  ],
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23",
      "sharp": ">=0.35.0"
    }
  }
}
